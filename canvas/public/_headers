# Cloudflare Pages: a board runs in an origin of its own, as server/sp.ts serves it (SANDBOX).
/board/*
  Content-Security-Policy: sandbox allow-scripts allow-forms allow-popups allow-modals allow-downloads

# A shared project's boards, at /p/<id>/ (vite.config.ts), are other people's HTML: the same.
/p/:id/board/*
  Content-Security-Policy: sandbox allow-scripts allow-forms allow-popups allow-modals allow-downloads
