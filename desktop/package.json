{
  "name": "super-prototyping-desktop",
  "private": true,
  "version": "1.4.1",
  "description": "The super-prototyping canvas as a macOS app",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "tsc --noEmit && bun build main.ts --target=node --format=esm --external electron --outfile dist/main.mjs",
    "start": "bun run build && electron .",
    "test": "bun test",
    "dist": "bun run build && electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "@types/node": "26",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "typescript": "7"
  },
  "trustedDependencies": ["electron"],
  "build": {
    "appId": "com.rescience.super-prototyping",
    "productName": "Super Prototyping",
    "artifactName": "Super-Prototyping-${version}-${arch}.${ext}",
    "directories": { "output": "dist/out" },
    "files": ["dist/main.mjs"],
    "extraResources": [{ "from": "../canvas/dist", "to": "dist" }],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "../assets/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    }
  }
}
