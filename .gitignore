node_modules
dist
dist-ssr
*.local
*.log

# Scratch output from tools/refkit.py — grids, shots, montages are regenerable.
shots/
scratch/

.DS_Store
.vscode/*
!.vscode/extensions.json
.idea

# Logo/design generation scratch — candidates stay local, only the final asset is committed
.skill-archive/

# Phase 5 reference boards embed third-party app captures from Mobbin's library,
# which this repo does not redistribute. They stay local; regenerate them per the
# sp-clone-prototype skill.
canvases/*/ref-*.html
canvases/*/refassets.json
canvases/*/assets/refs/
# spotify-ios is the exception: the hosted canvas is built from the checkout, so
# its captures sit under the replicas on the hosted page only as committed boards.
!canvases/spotify-ios/ref-*.html
# grok-ios shows one capture on the hosted page, under board 14, by request: a native
# screenshot, not a Mobbin one, parked where the replica can be compared against it.
!canvases/grok-ios/ref-14-grok-bot-sheet.html
# Same rule for the walkthrough row and its crops: they show the capture itself.
canvases/*/w[0-9]-*.html
canvases/*/walkassets.json
# Where the boards were until 2026-09-22. A checkout from before then keeps the captures
# ignored above there after a pull, since git moves only tracked files. Move them into
# canvases/; this keeps them out of a commit until then.
/mockups/
__pycache__/

# git worktrees created by agent sessions
.claude/worktrees/
