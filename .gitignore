node_modules
dist
dist-ssr
*.local
*.log

# Scratch output from tools/refkit.py — grids, shots, montages are regenerable.
shots/
scratch/

.DS_Store
.vscode/*
!.vscode/extensions.json
.idea

# Logo/design generation scratch — candidates stay local, only the final asset is committed
.skill-archive/

# Phase 5 reference boards embed third-party app captures from Mobbin's library,
# which this repo does not redistribute. They stay local; regenerate them per the
# clone-prototype skill.
mockups/canvases/*/ref-*.html
mockups/canvases/*/refassets.json
mockups/canvases/*/assets/refs/
# Same rule for the walkthrough row and its crops: they show the capture itself.
mockups/canvases/*/w[0-9]-*.html
mockups/canvases/*/walkassets.json
__pycache__/

# git worktrees created by agent sessions
.claude/worktrees/

# A motion asset's reference/ keeps the measurements taken off a third-party clip
# (BRIEF.md, motion.txt, the script that produced them), never the clip itself or
# frames pulled out of it. Same rule as the ref-*.html boards above.
#
# Written as an allowlist rather than a list of video extensions, because the point
# is that a third-party clip never lands in a commit, and the next reference dropped
# in here will be a .webm or a .gif or a .zip nobody thought to add to a denylist.
motion/src/*/*/reference/**
!motion/src/*/*/reference/*.md
!motion/src/*/*/reference/*.txt
!motion/src/*/*/reference/*.py
